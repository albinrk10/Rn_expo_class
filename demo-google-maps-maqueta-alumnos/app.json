{
  "expo": {
    "name": "demo-google-maps-maqueta-alumnos",
    "slug": "demo-google-maps-maqueta-alumnos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "demogooglemapsalumnos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.albin.semana10mapsalumnos",
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDsTI0WrpLX9HfS0i_xMwcA9AQ3hgDg6IA"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite usar tu ubicacion para centrar el mapa."
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Permite usar tu ubicacion para mostrarla en el mapa."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
